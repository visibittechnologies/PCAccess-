@{
    ViewBag.Title = "Profile";
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
}

<main class="ml-8 pt-8 pb-8 pr-4 pl-2 min-h-screen">
    <header class="mb-10">
        <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-primary text-3xl">account_circle</span>
            <h2 class="text-2xl font-bold tracking-tight text-slate-800 leading-none">Profile Settings</h2>
        </div>
    </header>

    <div class="space-y-6">
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-100">
            <div class="flex items-center gap-8">
                <div class="relative shrink-0">
                    <div class="w-24 h-24 rounded-full overflow-hidden shadow-inner bg-slate-100 ring-4 ring-white">
                        <img id="profile_img_preview" alt="Avatar" class="w-full h-full object-cover" src="/Content/assets/images/user.png" />
                    </div>
                </div>
                <div class="flex-1">
                    <h4 class="text-lg font-bold text-slate-800">Profile Photo</h4>
                    <p class="text-sm text-slate-500 mt-1">Change your profile picture here.</p>
                </div>
                <div class="flex gap-3">
                    <button onclick="$('#ProfilePhotoImage').click()" class="px-6 h-[44px] text-sm font-semibold bg-primary text-white rounded-xl shadow-md shadow-primary/20 hover:opacity-90 transition-all" type="button">
                        Upload New Photo
                    </button>
                    <button onclick="removeProfileImage()" class="px-6 h-[44px] text-sm font-semibold bg-[#ef4444] text-white rounded-xl shadow-md shadow-red-500/20 hover:opacity-90 transition-all" type="button">
                        Delete
                    </button>
                    <input type="file" id="ProfilePhotoImage" class="hidden" accept="image/*" />
                </div>
            </div>

            <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
                <div class="space-y-2">
                    <label class="text-sm font-bold text-slate-700 block">Full Name</label>
                    <input id="name" class="w-full h-[50px] px-5 border border-slate-100 rounded-xl text-sm bg-slate-50/50 transition-all focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary/30" placeholder="Enter full name" type="text" />
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-bold text-slate-700 block">Email</label>
                    <input id="email" class="w-full h-[50px] px-5 border border-slate-100 rounded-xl text-sm bg-slate-50/50 transition-all focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary/30" placeholder="admin@example.com" type="email" />
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-bold text-slate-700 block">Username</label>
                    <input id="username" class="w-full h-[50px] px-5 border border-slate-100 rounded-xl text-sm bg-slate-50/50 transition-all focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary/30" placeholder="username" type="text" />
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-bold text-slate-700 block">Password</label>
                    <div class="relative">
                        <input id="password" class="w-full h-[50px] px-5 pr-12 border border-slate-100 rounded-xl text-sm bg-slate-50/50 transition-all focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary/30" placeholder="••••••" type="password" />
                        <button class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-primary transition-colors" type="button" onclick="togglePasswordVisibility('#password')">
                            <span class="material-symbols-outlined text-xl">visibility</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-100">
            <div class="flex items-center gap-3 mb-8">
                <span class="material-symbols-outlined text-primary">history</span>
                <h3 class="text-lg font-bold text-slate-800">Change Password</h3>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
                <div class="space-y-2">
                    <label class="text-sm font-bold text-slate-700 block">New Password</label>
                    <div class="relative">
                        <input id="new_password" class="w-full h-[50px] px-5 pr-12 border border-slate-100 rounded-xl text-sm bg-slate-50/50 transition-all focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary/30" placeholder="********" type="password" />
                        <button class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-primary transition-colors" type="button" onclick="togglePasswordVisibility('#new_password')">
                            <span class="material-symbols-outlined text-xl">visibility</span>
                        </button>
                    </div>
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-bold text-slate-700 block">Confirm Password</label>
                    <div class="relative">
                        <input id="confirm_password" class="w-full h-[50px] px-5 pr-12 border border-slate-100 rounded-xl text-sm bg-slate-50/50 transition-all focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary/30" placeholder="********" type="password" />
                        <button class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-primary transition-colors" type="button" onclick="togglePasswordVisibility('#confirm_password')">
                            <span class="material-symbols-outlined text-xl">visibility</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="flex justify-end mt-10">
                <input type="hidden" id="user_id" value="@PCAccess.MyFun.CommanUtilities.Provider.GetCurrent().user_id" />
                <button id="BtnUpdateProfile" class="px-10 h-[50px] bg-primary text-white font-bold text-sm rounded-xl shadow-lg shadow-primary/30 hover:opacity-90 transition-all active:scale-95" type="submit">
                    Save Changes
                </button>
            </div>
        </div>
    </div>
</main>

<script src="~/MyAppjs/profile/profile.js"></script>
<script>
    function togglePasswordVisibility(selector) {
        const input = $(selector);
        const icon = input.next('button').find('span');
        if (input.attr('type') === 'password') {
            input.attr('type', 'text');
            icon.text('visibility_off');
        } else {
            input.attr('type', 'password');
            icon.text('visibility');
        }
    }
</script>
